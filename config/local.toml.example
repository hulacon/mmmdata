# Local configuration overrides for mmmdata.
#
# Copy this file to local.toml and uncomment/edit the settings you need.
# local.toml is gitignored -- it won't be committed to the repository.
# Values here are deep-merged over base.toml by core.config.load_config(),
# so only the keys you list change. The file is optional: load_config()
# reads base.toml alone when it is absent.
#
# Because this is per-operator, a [paths] block here is fine -- point at a
# local copy of the dataset, and only your checkout is affected. Do NOT put
# one in base.toml's place: if a path is wrong for everyone, fix base.toml.

# Example: a copy of the dataset outside Talapas (e.g. pulled over Globus).
# The root is the only key you need: output_dir (derivatives/) and
# inventory_dir (inventory/) move with it unless you set them here too.
# Setting MMMDATA_BIDS_ROOT in the environment does the same without a file,
# and wins over this one. The catalog does not travel with a copy; to have
# one, run `python -m duckbrain.catalog rebuild --root <copy>`.
# [paths]
# bids_project_dir = "/path/to/mmmdata"

# Example: every MCP toolset, including the ones that write (maintainers)
# [mcp]
# toolsets = ["all"]

# Example: set your email for SLURM notifications
# [slurm]
# email = "your.email@domain.com"
